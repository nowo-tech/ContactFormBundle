<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ 'demo.title'|trans({}, 'messages') }}{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="{{ asset('css/demo.css') }}" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('bundles/nowophoneinput/css/flag-icons.min.css') }}">
    <link rel="stylesheet" href="{{ asset('bundles/nowophoneinput/css/phone_input.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body class="demo-app d-flex flex-column">
    {% set _locale = app.request.locale %}
    {% set _current_route = app.request.attributes.get('_route') ?? 'demo_home' %}
    {% set _route_params = app.request.attributes.get('_route_params')|default({}) %}

    <nav class="navbar navbar-expand-lg navbar-dark demo-navbar mb-4">
        <div class="container">
            <a class="navbar-brand fw-semibold" href="{{ path('demo_home', { _locale: _locale }) }}">
                {{ 'demo.title'|trans({}, 'messages') }}
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#demoNavbar" aria-controls="demoNavbar" aria-expanded="false" aria-label="{{ 'demo.nav_toggle'|trans({}, 'messages') }}">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="demoNavbar">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link {{ _current_route == 'demo_home' ? 'active' : '' }}" href="{{ path('demo_home', { _locale: _locale }) }}">
                            {{ 'demo.menu_home'|trans({}, 'messages') }}
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle {{ _current_route == 'nowo_contact_form_public_show' ? 'active' : '' }}" href="#" id="formsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            {{ 'demo.menu_public_forms'|trans({}, 'messages') }}
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="formsDropdown">
                            <li><a class="dropdown-item" href="{{ path('nowo_contact_form_public_show', { slug: 'contact', _locale: _locale }) }}">{{ 'demo.form_contact'|trans({}, 'messages') }}</a></li>
                            <li><a class="dropdown-item" href="{{ path('nowo_contact_form_public_show', { slug: 'job-application', _locale: _locale }) }}">{{ 'demo.form_job'|trans({}, 'messages') }}</a></li>
                            <li><a class="dropdown-item" href="{{ path('nowo_contact_form_public_show', { slug: 'partner-inquiry', _locale: _locale }) }}">{{ 'demo.form_partner'|trans({}, 'messages') }}</a></li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ _current_route starts with 'nowo_contact_form_admin' or _current_route starts with 'nowo_contact_form_fields' or _current_route starts with 'nowo_contact_form_submissions' ? 'active' : '' }}" href="{{ path('nowo_contact_form_admin_index') }}">
                            {{ 'demo.menu_admin'|trans({}, 'messages') }}
                        </a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="localeDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            {{ _locale == 'es' ? 'Español' : 'English' }}
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="localeDropdown">
                            <li>
                                <a class="dropdown-item {{ _locale == 'en' ? 'active' : '' }}" href="{{ path(_current_route, _route_params|merge({ _locale: 'en' })|filter((value, key) => key != '_fragment')) }}">English</a>
                            </li>
                            <li>
                                <a class="dropdown-item {{ _locale == 'es' ? 'active' : '' }}" href="{{ path(_current_route, _route_params|merge({ _locale: 'es' })|filter((value, key) => key != '_fragment')) }}">Español</a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container flex-grow-1 pb-5">
        {% block body %}{% endblock %}
    </main>

    <footer class="demo-footer border-top bg-white py-3 mt-auto">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>{{ 'demo.footer'|trans({}, 'messages') }}</span>
            <span class="badge text-bg-light border">{{ 'demo.symfony_badge'|trans({}, 'messages') }}</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
