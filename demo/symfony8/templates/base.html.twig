{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell (@NowoUiKit/demo_platform/layout.html.twig):
    the same top bar, aside, content width, theme and footer as every other nowo-tech bundle demo. This file only
    declares the demo (nowo_ui_demo_platform). Bundle pages render through the same shell (nowo_ui_kit.layouts). -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set nowo_ui_demo_platform = {
    bundle: 'Contact Form',
    home_route: 'demo_home',
    repository: 'https://github.com/nowo-tech/ContactFormBundle',
    translation_domain: 'messages',
    locales: ['en', 'es'],
    nav: [
        {label: 'demo.menu_home', route: 'demo_home'},
        {label: 'demo.form_contact', route: 'nowo_contact_form_public_show', params: {slug: 'contact'}, section: 'demo.menu_public_forms', testid: 'demo-nav-nowo_contact_form_public_show-contact'},
        {label: 'demo.form_job', route: 'nowo_contact_form_public_show', params: {slug: 'job-application'}, section: 'demo.menu_public_forms', testid: 'demo-nav-nowo_contact_form_public_show-job-application'},
        {label: 'demo.form_partner', route: 'nowo_contact_form_public_show', params: {slug: 'partner-inquiry'}, section: 'demo.menu_public_forms', testid: 'demo-nav-nowo_contact_form_public_show-partner-inquiry'},
        {label: 'demo.menu_forms', route: 'nowo_contact_form_admin_index', active: ['nowo_contact_form_admin_*', 'nowo_contact_form_fields_*', 'nowo_contact_form_submissions_*'], section: 'demo.menu_admin'},
    ],
} %}

{% block nowo_ui_document_title %}{% block title %}{{ 'demo.title'|trans({}, 'messages') }}{% endblock %} — Symfony 8{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('bundles/nowophoneinput/css/flag-icons.min.css') }}">
    <link rel="stylesheet" href="{{ asset('bundles/nowophoneinput/css/phone_input.css') }}">
{% endblock %}
