{% extends 'base.html.twig' %}

{% block title %}{{ translation.title }}{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-lg-8 contact-form-card">
            <div class="mb-3">
                <a href="{{ path('demo_home', { _locale: app.request.locale }) }}" class="btn btn-sm btn-outline-secondary">
                    {{ 'demo.back_home'|trans({}, 'messages') }}
                </a>
            </div>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5">
                    <h1 class="h3 mb-2">{{ translation.title }}</h1>

                    {% if translation.description %}
                        <p class="text-secondary mb-4">{{ translation.description }}</p>
                    {% endif %}

                    {{ form_start(form) }}
                        {% include '@NowoContactFormBundle/public/_form_fields.html.twig' with {
                            form: form,
                            contactForm: contactForm,
                            translation: translation,
                        } only %}

                        <button type="submit" class="btn btn-primary w-100 w-md-auto">
                            {{ 'nowo_contact_form.public.submit'|trans({}, 'NowoContactFormBundle') }}
                        </button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
