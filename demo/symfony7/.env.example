# Demo: dev environment (Web Profiler, debug toolbar). docker-compose also forces APP_ENV=dev.
PORT=8020

###> symfony/framework-bundle ###
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change_this_secret_key_to_a_random_value
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
###< doctrine/doctrine-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8020
###< symfony/routing ###
