{#
  Body of the public contact form (REQ-TWIG-003): the child loop for the dynamic fields, then the GDPR consent
  checkbox with the optional privacy policy link. Variables: form (FormView), contactForm (ContactForm), translation
  (ContactFormTranslation), optional bundle (UiKit theme exceptions, default NowoContactFormBundle).
#}
{% set _b = bundle|default('NowoContactFormBundle') %}
{% for child in form %}
    {% if not child.rendered and child.vars.name != 'gdpr_consent' %}
        {{ form_row(child) }}
    {% endif %}
{% endfor %}

{% if form.gdpr_consent is defined %}
    <div class="{{ nowo_ui_class('form_row', _b) }}">
        {{ form_row(form.gdpr_consent) }}
        {#- http(s) only: a legacy javascript: / data: URL stored before 1.6 is not rendered as a link -#}
        {% if contactForm.privacyPolicyUrl and translation.privacyPolicyText and contactForm.privacyPolicyUrl matches '{^https?://}i' %}
            <p class="{{ nowo_ui_class('muted', _b) }}">
                <a href="{{ contactForm.privacyPolicyUrl }}" target="_blank" rel="noopener">{{ translation.privacyPolicyText }}</a>
            </p>
        {% endif %}
    </div>
{% endif %}
