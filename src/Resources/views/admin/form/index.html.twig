{% extends '@NowoContactFormBundle/admin/base.html.twig' %}

{% block title %}{{ 'nowo_contact_form.admin.form.index_title'|trans({}, 'NowoContactFormBundle') }}{% endblock %}

{% block content %}
    <div class="nowo-ui-page-header d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h1 class="h2 mb-0">{{ 'nowo_contact_form.admin.form.index_title'|trans({}, 'NowoContactFormBundle') }}</h1>
        <a href="{{ path('nowo_contact_form_admin_new') }}" class="btn btn-primary nowo-ui-action-create">
            {{ 'nowo_contact_form.admin.form.new'|trans({}, 'NowoContactFormBundle') }}
        </a>
    </div>

    <div class="nowo-ui-table-wrap card shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0 align-middle nowo-ui-table">
                <thead class="table-light">
                    <tr>
                        <th>{{ 'nowo_contact_form.admin.form.columns.name'|trans({}, 'NowoContactFormBundle') }}</th>
                        <th>{{ 'nowo_contact_form.admin.form.columns.slug'|trans({}, 'NowoContactFormBundle') }}</th>
                        <th>{{ 'nowo_contact_form.admin.form.columns.enabled'|trans({}, 'NowoContactFormBundle') }}</th>
                        <th class="text-end">{{ 'nowo_contact_form.admin.form.columns.actions'|trans({}, 'NowoContactFormBundle') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for contactForm in forms %}
                        <tr>
                            <td class="fw-medium">{{ contactForm.name }}</td>
                            <td><code>{{ contactForm.slug }}</code></td>
                            <td>
                                {% if contactForm.enabled %}
                                    <span class="badge text-bg-success">{{ 'nowo_contact_form.admin.yes'|trans({}, 'NowoContactFormBundle') }}</span>
                                {% else %}
                                    <span class="badge text-bg-secondary">{{ 'nowo_contact_form.admin.no'|trans({}, 'NowoContactFormBundle') }}</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a href="{{ path('nowo_contact_form_admin_edit', { id: contactForm.id }) }}" class="btn btn-outline-primary nowo-ui-action-edit">
                                        {{ 'nowo_contact_form.admin.actions.edit'|trans({}, 'NowoContactFormBundle') }}
                                    </a>
                                    <a href="{{ path('nowo_contact_form_fields_index', { formId: contactForm.id }) }}" class="btn btn-outline-secondary">
                                        {{ 'nowo_contact_form.admin.actions.fields'|trans({}, 'NowoContactFormBundle') }}
                                    </a>
                                    <a href="{{ path('nowo_contact_form_submissions_index', { formId: contactForm.id }) }}" class="btn btn-outline-secondary">
                                        {{ 'nowo_contact_form.admin.actions.submissions'|trans({}, 'NowoContactFormBundle') }}
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                {{ 'nowo_contact_form.admin.form.empty'|trans({}, 'NowoContactFormBundle') }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% include '@NowoContactFormBundle/admin/_pagination.html.twig' %}
{% endblock %}
