{#
  Contact forms (REQ-UI-003): UiKit list scaffold. Variable: page (View\ListPage from ContactFormPageFactory::formIndex():
  header nowo_contact_form.admin.form.index_title with the action New form; columns name, slug, enabled; rows =
  list<ContactForm>; row actions Edit / Fields / Submissions / Delete (POST + CSRF FormView behind a Confirm);
  Pagination; EmptyState nowo_contact_form.admin.form.empty).
  Data block filled: nowo_ui_list_row (cells).
#}
{% extends '@NowoUiKit/page/list.html.twig' %}
{% trans_default_domain 'NowoContactFormBundle' %}

{% block nowo_ui_list_row %}
    {% set _b = page.bundle %}
    {% set _cell = nowo_ui_class('table_cell', _b) %}
    <td class="{{ _cell }}" data-label="{{ 'nowo_contact_form.admin.form.columns.name'|trans }}" data-required="1">{{ row.name }}</td>
    <td class="{{ _cell }}" data-label="{{ 'nowo_contact_form.admin.form.columns.slug'|trans }}"><code class="{{ nowo_ui_class('code', _b) }}">{{ row.slug }}</code></td>
    <td class="{{ _cell }}" data-label="{{ 'nowo_contact_form.admin.form.columns.enabled'|trans }}" data-nowo-ui-priority="2">
        <span class="{{ nowo_ui_class(row.enabled ? 'badge_success' : 'badge_neutral', _b) }}">{{ (row.enabled ? 'nowo_contact_form.admin.yes' : 'nowo_contact_form.admin.no')|trans }}</span>
    </td>
{% endblock %}
