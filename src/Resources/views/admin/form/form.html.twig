{#
  Contact form create / edit (REQ-UI-003): UiKit form scaffold. Variable: page (View\FormPage from
  ContactFormPageFactory::formForm(): header new_title / edit_title (intro = form name on edit) with a back link to
  the list; form = ContactFormType; submit nowo_contact_form.admin.form.save; cancel = list; on edit the Fields /
  Submissions secondary actions and the delete zone (POST + CSRF FormView behind a Confirm)).
  Data block filled: nowo_ui_form_body (REQ-TWIG-003 child loop, then the locale tabs of the translations).
#}
{% extends '@NowoUiKit/page/form.html.twig' %}
{% trans_default_domain 'NowoContactFormBundle' %}

{% block nowo_ui_form_body %}
    {% for child in form %}
        {% if not child.rendered and child.vars.name != 'translations' %}
            {{ form_row(child) }}
        {% endif %}
    {% endfor %}
    {{ include('@NowoContactFormBundle/admin/form/_translation_tabs.html.twig', {form: form, bundle: page.bundle}, with_context: false) }}
    {{ parent() }}
{% endblock %}
