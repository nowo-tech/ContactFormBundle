{#
  Translations of a contact form as locale tabs: FormKit locale_tabs (mode entries) rendered through the UiKit
  locale_tabs partial (default locale first and marked ★, required locales *, invalid tabs ! and opened first,
  keyboard navigation, no Bootstrap JS). Required: form (with a `translations` collection); optional bundle (theme
  exceptions of the UiKit slots, default NowoContactFormBundle).
#}
{% if form.translations is defined %}
{% set _b = bundle|default('NowoContactFormBundle') %}
{% set _locales = contact_form_admin_locales() %}
{% set _default = contact_form_admin_default_locale() %}
{% set _labels = {} %}
{% for _locale in _locales %}
    {% set _labels = _labels|merge({(_locale): ('nowo_contact_form.admin.locales.' ~ _locale)|trans({}, 'NowoContactFormBundle')}) %}
{% endfor %}

<fieldset class="{{ nowo_ui_class('form_row', _b) }}">
    <legend class="{{ nowo_ui_class('form_label', _b) }}">
        {{ 'nowo_contact_form.admin.form.fields.translations'|trans({}, 'NowoContactFormBundle') }}
    </legend>

    {% if form.translations|length > 0 %}
        {{ form_errors(form.translations) }}
        {{ include('@NowoFormKitBundle/form/_locale_tabs.html.twig', form.translations.vars.locale_tabs|default({})|merge({
            field: form.translations,
            mode: 'entries',
            default_locale: _default,
            required_locales: _locales,
            locale_labels: _labels,
            tabs_label: 'nowo_contact_form.admin.form.fields.translations'|trans({}, 'NowoContactFormBundle'),
            tabs_id: 'form-translation',
            testid: 'form-translation-tabs',
        }), with_context: false) }}
    {% else %}
        <p class="{{ nowo_ui_class('muted', _b) }}">{{ 'nowo_contact_form.admin.form.fields.translations_empty'|trans({}, 'NowoContactFormBundle') }}</p>
    {% endif %}
</fieldset>

{% do form.translations.setRendered %}
{% endif %}
