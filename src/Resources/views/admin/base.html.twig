{# Page shell (REQ-UI-001): extends configurable layout and stacks admin extras with parent(). #}
{% extends nowo_contact_form_layout_template|default('@NowoContactFormBundle/admin/layout.html.twig') %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set _css_fw = nowo_contact_form_css_framework|default('bootstrap5') %}

{% block nowo_ui_flashes %}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="{{ ui.flash(label == 'error' ? 'error' : label, _css_fw) }}" role="alert">{{ message }}</div>
        {% endfor %}
    {% endfor %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% block nowo_ui_styles %}
        <link rel="stylesheet" href="{{ asset('css/nowo-ui.css', 'nowo_ui_kit') }}">
    {% endblock %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% block nowo_ui_scripts %}
        {% set _csp_nonce = app.request is defined and app.request ? app.request.attributes.get('csp_nonce')|default('') : '' %}
        <script{% if _csp_nonce %} nonce="{{ _csp_nonce }}"{% endif %}>
            document.getElementById('admin-locale-switch')?.addEventListener('change', function () {
                const locale = this.checked ? this.dataset.secondaryLocale : this.dataset.primaryLocale;
                window.location.href = this.dataset.switchUrl.replace('__LOCALE__', locale);
            });
            {#- CSP: confirmation prompts via data-confirm instead of inline onsubmit handlers. -#}
            document.addEventListener('submit', function (event) {
                const form = event.target instanceof HTMLFormElement ? event.target : null;
                if (form && form.dataset.confirm && !window.confirm(form.dataset.confirm)) {
                    event.preventDefault();
                }
            });
        </script>
    {% endblock %}
{% endblock %}
