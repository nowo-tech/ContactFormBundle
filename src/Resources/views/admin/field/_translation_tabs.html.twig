{#
  Translations of a contact field as locale tabs: FormKit locale_tabs (mode entries) rendered through the UiKit
  locale_tabs partial (default locale first and marked ★, required locales *, invalid tabs ! and opened first,
  keyboard navigation, no Bootstrap JS). Required: form (with a `translations` collection).
#}
{% if form.translations is defined %}
{% set _locales = contact_form_admin_locales() %}
{% set _default = contact_form_admin_default_locale() %}
{% set _labels = {} %}
{% for _locale in _locales %}
    {% set _labels = _labels|merge({(_locale): ('nowo_contact_form.admin.locales.' ~ _locale)|trans({}, 'NowoContactFormBundle')}) %}
{% endfor %}

<fieldset class="mb-3">
    <legend class="form-label fs-6 fw-semibold">
        {{ 'nowo_contact_form.admin.field.fields.translations'|trans({}, 'NowoContactFormBundle') }}
    </legend>

    {% if form.translations|length > 0 %}
        {{ form_errors(form.translations) }}
        {{ include('@NowoFormKitBundle/form/_locale_tabs.html.twig', form.translations.vars.locale_tabs|default({})|merge({
            field: form.translations,
            mode: 'entries',
            default_locale: _default,
            required_locales: _locales,
            locale_labels: _labels,
            tabs_label: 'nowo_contact_form.admin.field.fields.translations'|trans({}, 'NowoContactFormBundle'),
            tabs_id: 'field-translation',
            testid: 'field-translation-tabs',
        }), with_context: false) }}
    {% else %}
        <p class="text-muted mb-0">{{ 'nowo_contact_form.admin.field.fields.translations_empty'|trans({}, 'NowoContactFormBundle') }}</p>
    {% endif %}
</fieldset>

{% do form.translations.setRendered %}
{% endif %}
