{#
  Fields of a contact form (REQ-UI-003): UiKit list scaffold. Variable: page (View\ListPage from
  ContactFormPageFactory::fieldIndex(): header nowo_contact_form.admin.field.index_title (intro = form name) with the
  action New field and a back link to the forms; columns name, type, required; rows = list<ContactFormField> plus, when
  the form requires GDPR consent, the pseudo row {consent: true, name: 'gdpr_consent'} (edited on the form); row
  actions Edit / Delete (POST + CSRF FormView behind a Confirm); EmptyState nowo_contact_form.admin.field.empty).
  Data block filled: nowo_ui_list_row (cells).
#}
{% extends '@NowoUiKit/page/list.html.twig' %}
{% trans_default_domain 'NowoContactFormBundle' %}

{% block nowo_ui_list_row %}
    {% set _b = page.bundle %}
    {% set _cell = nowo_ui_class('table_cell', _b) %}
    {% if row.consent is defined and row.consent %}
        <td class="{{ _cell }}" data-label="{{ 'nowo_contact_form.admin.field.columns.name'|trans }}" data-required="1">
            <code class="{{ nowo_ui_class('code', _b) }}">{{ row.name }}</code>
            <span class="{{ nowo_ui_class('muted', _b) }}">{{ 'nowo_contact_form.admin.field.consent_row.hint'|trans }}</span>
        </td>
        <td class="{{ _cell }}" data-label="{{ 'nowo_contact_form.admin.field.columns.type'|trans }}">
            <span class="{{ nowo_ui_class('badge_info', _b) }}">{{ 'nowo_contact_form.admin.field.consent_row.type'|trans }}</span>
        </td>
        <td class="{{ _cell }}" data-label="{{ 'nowo_contact_form.admin.field.columns.required'|trans }}" data-nowo-ui-priority="2">
            <span class="{{ nowo_ui_class('badge_success', _b) }}">{{ 'nowo_contact_form.admin.yes'|trans }}</span>
        </td>
    {% else %}
        <td class="{{ _cell }}" data-label="{{ 'nowo_contact_form.admin.field.columns.name'|trans }}" data-required="1"><code class="{{ nowo_ui_class('code', _b) }}">{{ row.name }}</code></td>
        <td class="{{ _cell }}" data-label="{{ 'nowo_contact_form.admin.field.columns.type'|trans }}">
            <span class="{{ nowo_ui_class('badge_neutral', _b) }}">{{ ('nowo_contact_form.admin.field.type.' ~ row.type.value)|trans }}</span>
        </td>
        <td class="{{ _cell }}" data-label="{{ 'nowo_contact_form.admin.field.columns.required'|trans }}" data-nowo-ui-priority="2">
            <span class="{{ nowo_ui_class(row.required ? 'badge_success' : 'badge_neutral', _b) }}">{{ (row.required ? 'nowo_contact_form.admin.yes' : 'nowo_contact_form.admin.no')|trans }}</span>
        </td>
    {% endif %}
{% endblock %}
