{% extends '@NowoContactFormBundle/admin/base.html.twig' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set _css_fw = nowo_contact_form_css_framework|default('bootstrap5') %}

{% block title %}{{ 'nowo_contact_form.admin.field.index_title'|trans({}, 'NowoContactFormBundle') }}{% endblock %}

{% block content %}
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <p class="text-muted mb-1">{{ contactForm.name }}</p>
            <h1 class="h2 mb-0">{{ 'nowo_contact_form.admin.field.index_title'|trans({}, 'NowoContactFormBundle') }}</h1>
        </div>
        <a href="{{ path('nowo_contact_form_fields_new', { formId: contactForm.id, step: 'definition' }) }}" class="{{ ui.btn('primary', null, _css_fw) }} nowo-ui-action-create">
            {{ 'nowo_contact_form.admin.field.new'|trans({}, 'NowoContactFormBundle') }}
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>{{ 'nowo_contact_form.admin.field.columns.name'|trans({}, 'NowoContactFormBundle') }}</th>
                        <th>{{ 'nowo_contact_form.admin.field.columns.type'|trans({}, 'NowoContactFormBundle') }}</th>
                        <th>{{ 'nowo_contact_form.admin.field.columns.required'|trans({}, 'NowoContactFormBundle') }}</th>
                        <th class="text-end">{{ 'nowo_contact_form.admin.field.columns.actions'|trans({}, 'NowoContactFormBundle') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for field in fields %}
                        <tr>
                            <td class="fw-medium">{{ field.name }}</td>
                            <td><span class="badge text-bg-light border">{{ field.type.value }}</span></td>
                            <td>
                                {% if field.required %}
                                    <span class="badge text-bg-success">{{ 'nowo_contact_form.admin.yes'|trans({}, 'NowoContactFormBundle') }}</span>
                                {% else %}
                                    <span class="badge text-bg-secondary">{{ 'nowo_contact_form.admin.no'|trans({}, 'NowoContactFormBundle') }}</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <div class="{{ ui.row_actions(_css_fw) }}">
                                    <a href="{{ path('nowo_contact_form_fields_edit', { formId: contactForm.id, id: field.id, step: 'definition' }) }}" class="{{ ui.btn('secondary', 'sm', _css_fw) }} nowo-ui-action-edit">
                                        {{ 'nowo_contact_form.admin.actions.edit'|trans({}, 'NowoContactFormBundle') }}
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                {{ 'nowo_contact_form.admin.field.empty'|trans({}, 'NowoContactFormBundle') }}
                            </td>
                        </tr>
                    {% endfor %}
                    {% if contactForm.requireConsent %}
                        <tr class="table-light">
                            <td class="fw-medium">
                                <code>gdpr_consent</code>
                                <div class="small text-muted">{{ 'nowo_contact_form.admin.field.consent_row.hint'|trans({}, 'NowoContactFormBundle') }}</div>
                            </td>
                            <td><span class="badge text-bg-info">{{ 'nowo_contact_form.admin.field.consent_row.type'|trans({}, 'NowoContactFormBundle') }}</span></td>
                            <td>
                                <span class="badge text-bg-success">{{ 'nowo_contact_form.admin.yes'|trans({}, 'NowoContactFormBundle') }}</span>
                            </td>
                            <td class="text-end">
                                <div class="{{ ui.row_actions(_css_fw) }}">
                                    <a href="{{ path('nowo_contact_form_admin_edit', { id: contactForm.id }) }}" class="{{ ui.btn('secondary', 'sm', _css_fw) }} nowo-ui-action-edit">
                                        {{ 'nowo_contact_form.admin.field.consent_row.edit'|trans({}, 'NowoContactFormBundle') }}
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>

    <a href="{{ path('nowo_contact_form_admin_index') }}" class="{{ ui.btn('secondary', null, _css_fw) }} nowo-ui-action-cancel">
        {{ 'nowo_contact_form.admin.back'|trans({}, 'NowoContactFormBundle') }}
    </a>
{% endblock %}
