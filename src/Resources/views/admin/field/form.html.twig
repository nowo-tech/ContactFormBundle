{#
  Field create / edit wizard (REQ-UI-003): UiKit wizard scaffold over the Symfony FormFlow ContactFormFieldFlowType.
  Variable: page (View\WizardPage from ContactFormPageFactory::fieldWizard(): header new_title / edit_title (intro =
  form name) with a back link to the fields; steps = the visible flow steps (definition, select_options,
  phone_prefixes, content; done steps link to their URL); current = current step; form = the flow FormView;
  backHref = fields list).
  Data block filled: nowo_ui_wizard_step (the current step's fields with the REQ-TWIG-003 child loop, the locale
  tabs of the translations, then the flow navigator buttons previous / next / finish and the back link).
#}
{% extends '@NowoUiKit/page/wizard.html.twig' %}
{% trans_default_domain 'NowoContactFormBundle' %}

{% block nowo_ui_wizard_step %}
    {% set _b = page.bundle %}
    {% set _form = page.form %}
    {{ form_start(_form, {attr: {class: nowo_ui_class('form', _b), 'data-nowo-ui-region': 'form'}}) }}
        {% for name, stepForm in _form %}
            {% if name == page.current %}
                {% for child in stepForm %}
                    {% if not child.rendered and child.vars.name != 'translations' %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
                {{ include('@NowoContactFormBundle/admin/field/_translation_tabs.html.twig', {form: stepForm, bundle: _b}, with_context: false) }}
            {% endif %}
        {% endfor %}

        {% if _form.navigator is defined %}
            <div class="{{ nowo_ui_class('form_actions', _b) }}"{{ nowo_ui_attrs('form_actions', _b) }}>
                {% if _form.navigator.previous is defined %}
                    {{ form_widget(_form.navigator.previous, {label: 'nowo_contact_form.admin.field.flow.previous'|trans, translation_domain: false, attr: {class: nowo_ui_class('btn_secondary', _b)}}) }}
                {% endif %}
                {% if _form.navigator.next is defined %}
                    {{ form_widget(_form.navigator.next, {label: page.nextLabel|nowo_ui_trans, translation_domain: false, attr: {class: nowo_ui_class('btn_primary', _b)}}) }}
                {% endif %}
                {% if _form.navigator.finish is defined %}
                    {{ form_widget(_form.navigator.finish, {label: 'nowo_contact_form.admin.field.flow.finish'|trans, translation_domain: false, attr: {class: nowo_ui_class('btn_primary', _b)}}) }}
                {% endif %}
                <a class="{{ nowo_ui_class('btn_secondary', _b) }}" href="{{ page.backHref }}" data-testid="contact-form-field-cancel">{{ page.backLabel|nowo_ui_trans }}</a>
            </div>
        {% endif %}
    {{ form_end(_form) }}
{% endblock %}
