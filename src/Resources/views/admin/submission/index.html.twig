{#
  Submissions of a contact form (REQ-UI-003): UiKit list scaffold. Variable: page (View\ListPage from
  ContactFormPageFactory::submissionIndex(): header nowo_contact_form.admin.submission.index_title (intro = form name)
  with a back link to the forms; columns date, client, locale; rows = list<ContactSubmission>; row actions View /
  Delete (POST + CSRF FormView behind a Confirm); Pagination; EmptyState nowo_contact_form.admin.submission.empty).
  Data block filled: nowo_ui_list_row (cells).
#}
{% extends '@NowoUiKit/page/list.html.twig' %}
{% trans_default_domain 'NowoContactFormBundle' %}

{% block nowo_ui_list_row %}
    {% set _b = page.bundle %}
    {% set _cell = nowo_ui_class('table_cell', _b) %}
    <td class="{{ _cell }}" data-label="{{ 'nowo_contact_form.admin.submission.columns.date'|trans }}" data-required="1">{{ row.createdAt|date('Y-m-d H:i') }}</td>
    <td class="{{ _cell }}" data-label="{{ 'nowo_contact_form.admin.submission.columns.client'|trans }}">
        {% if row.anonymous %}
            <span class="{{ nowo_ui_class('muted', _b) }}">{{ 'nowo_contact_form.admin.submission.anonymous'|trans }}</span>
        {% else %}
            {{ row.clientLabel ?? row.clientId }}
        {% endif %}
    </td>
    <td class="{{ _cell }}" data-label="{{ 'nowo_contact_form.admin.submission.columns.locale'|trans }}" data-nowo-ui-priority="2">
        <span class="{{ nowo_ui_class('badge_neutral', _b) }}">{{ row.locale }}</span>
    </td>
{% endblock %}
