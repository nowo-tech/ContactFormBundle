{% extends nowo_contact_form_layout_template|default('@NowoContactFormBundle/admin/layout.html.twig') %}

{% block title %}{{ 'nowo_contact_form.admin.submission.index_title'|trans({}, 'NowoContactFormBundle') }}{% endblock %}

{% block content %}
    <div class="mb-4">
        <p class="text-muted mb-1">{{ contactForm.name }}</p>
        <h1 class="h2 mb-0">{{ 'nowo_contact_form.admin.submission.index_title'|trans({}, 'NowoContactFormBundle') }}</h1>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>{{ 'nowo_contact_form.admin.submission.columns.date'|trans({}, 'NowoContactFormBundle') }}</th>
                        <th>{{ 'nowo_contact_form.admin.submission.columns.client'|trans({}, 'NowoContactFormBundle') }}</th>
                        <th>{{ 'nowo_contact_form.admin.submission.columns.locale'|trans({}, 'NowoContactFormBundle') }}</th>
                        <th class="text-end">{{ 'nowo_contact_form.admin.submission.columns.actions'|trans({}, 'NowoContactFormBundle') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for submission in submissions %}
                        <tr>
                            <td>{{ submission.createdAt|date('Y-m-d H:i') }}</td>
                            <td>
                                {% if submission.anonymous %}
                                    <span class="text-muted">{{ 'nowo_contact_form.admin.submission.anonymous'|trans({}, 'NowoContactFormBundle') }}</span>
                                {% else %}
                                    {{ submission.clientLabel ?? submission.clientId }}
                                {% endif %}
                            </td>
                            <td><span class="badge text-bg-light border">{{ submission.locale }}</span></td>
                            <td class="text-end">
                                <a href="{{ path('nowo_contact_form_submissions_show', { formId: contactForm.id, id: submission.id }) }}" class="btn btn-sm btn-outline-primary nowo-ui-action-view">
                                    {{ 'nowo_contact_form.admin.actions.view'|trans({}, 'NowoContactFormBundle') }}
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                {{ 'nowo_contact_form.admin.submission.empty'|trans({}, 'NowoContactFormBundle') }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% include '@NowoContactFormBundle/admin/_pagination.html.twig' %}

    <a href="{{ path('nowo_contact_form_admin_index') }}" class="btn btn-outline-secondary">
        {{ 'nowo_contact_form.admin.back'|trans({}, 'NowoContactFormBundle') }}
    </a>
{% endblock %}
