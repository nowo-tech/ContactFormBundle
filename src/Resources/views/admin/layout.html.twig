<!DOCTYPE html>
<html lang="{{ app.request.locale }}" class="nowo-ui-root nowo-ui-css-{{ nowo_contact_form_css_framework|default('bootstrap5') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block nowo_ui_document_title %}{% block title %}Contact Form Admin{% endblock %}{% endblock %}</title>
    {% block stylesheets %}
        {% block nowo_ui_styles %}
            {% if nowo_contact_form_css_framework|default('bootstrap5') in ['bootstrap', 'bootstrap5', 'bootstrap4', 'tabler'] %}
                <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
            {% endif %}
        {% endblock %}
    {% endblock %}
</head>
<body class="bg-light nowo-ui-body">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 nowo-ui-nav">
        <div class="container">
            <a class="navbar-brand" href="{{ path('nowo_contact_form_admin_index') }}">
                {{ 'nowo_contact_form.admin.nav.brand'|trans({}, 'NowoContactFormBundle') }}
            </a>
            <div class="ms-auto">
                {% include '@NowoContactFormBundle/admin/_locale_switch.html.twig' %}
            </div>
        </div>
    </nav>

    <main class="container pb-5 nowo-ui-main">
        {% block nowo_ui_flashes %}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}
        {% endblock %}

        {% block nowo_ui_content %}
            {% block content %}{% endblock %}
        {% endblock %}
        {% block nowo_ui_modals %}{% endblock %}
    </main>

    {% block javascripts %}
        {% block nowo_ui_scripts %}
            {% if nowo_contact_form_css_framework|default('bootstrap5') in ['bootstrap', 'bootstrap5', 'bootstrap4', 'tabler'] %}
                <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
            {% endif %}
            <script>
                document.getElementById('admin-locale-switch')?.addEventListener('change', function () {
                    const locale = this.checked ? this.dataset.secondaryLocale : this.dataset.primaryLocale;
                    window.location.href = this.dataset.switchUrl.replace('__LOCALE__', locale);
                });
            </script>
        {% endblock %}
    {% endblock %}
</body>
</html>
