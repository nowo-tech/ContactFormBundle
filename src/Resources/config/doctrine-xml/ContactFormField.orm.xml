<?xml version="1.0" encoding="UTF-8"?>
<!-- Since 1.9.0: XML mapping of the bundle entity (same tables, columns, indexes and constraints as its attributes). Used with nowo_contact_form.doctrine.mapping_type: xml, or by a host that maps the bundle entities itself. -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\ContactFormBundle\Entity\ContactFormField" table="nowo_contact_form_field" repository-class="Nowo\ContactFormBundle\Repository\ContactFormFieldRepository">
        <unique-constraints>
            <unique-constraint name="uniq_contact_form_field_name" columns="form_id,name"/>
        </unique-constraints>
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>
        <field name="name" type="string" length="120"/>
        <field name="type" type="string" length="20" enum-type="Nowo\ContactFormBundle\Enum\ContactFieldType"/>
        <field name="required" type="boolean">
            <options>
                <option name="default">0</option>
            </options>
        </field>
        <field name="sortOrder" column="sort_order" type="integer">
            <options>
                <option name="default">0</option>
            </options>
        </field>
        <field name="options" type="json" nullable="true"/>
        <many-to-one field="form" target-entity="Nowo\ContactFormBundle\Entity\ContactForm" inversed-by="fields">
            <join-column nullable="false" on-delete="CASCADE"/>
        </many-to-one>
        <one-to-many field="translations" target-entity="Nowo\ContactFormBundle\Entity\ContactFormFieldTranslation" mapped-by="field" orphan-removal="true">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>
    </entity>
</doctrine-mapping>
