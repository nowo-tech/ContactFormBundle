<?xml version="1.0" encoding="UTF-8"?>
<!-- Since 1.9.0: XML mapping of the bundle entity (same tables, columns, indexes and constraints as its attributes). Used with nowo_contact_form.doctrine.mapping_type: xml, or by a host that maps the bundle entities itself. -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\ContactFormBundle\Entity\ContactSubmission" table="nowo_contact_submission" repository-class="Nowo\ContactFormBundle\Repository\ContactSubmissionRepository">
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>
        <field name="clientId" column="client_id" type="integer" nullable="true"/>
        <field name="clientReference" column="client_reference" type="string" length="64" nullable="true"/>
        <field name="clientLabel" column="client_label" type="string" length="255" nullable="true"/>
        <field name="locale" type="string" length="10"/>
        <field name="ipHash" column="ip_hash" type="string" length="64" nullable="true"/>
        <field name="consentGivenAt" column="consent_given_at" type="datetime_immutable" nullable="true"/>
        <field name="createdAt" column="created_at" type="datetime_immutable"/>
        <many-to-one field="form" target-entity="Nowo\ContactFormBundle\Entity\ContactForm">
            <join-column nullable="false" on-delete="CASCADE"/>
        </many-to-one>
        <one-to-many field="values" target-entity="Nowo\ContactFormBundle\Entity\ContactSubmissionValue" mapped-by="submission" orphan-removal="true">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>
    </entity>
</doctrine-mapping>
