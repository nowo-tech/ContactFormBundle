<?xml version="1.0" encoding="UTF-8"?>
<!-- Since 1.9.0: XML mapping of the bundle entity (same tables, columns, indexes and constraints as its attributes). Used with nowo_contact_form.doctrine.mapping_type: xml, or by a host that maps the bundle entities itself. -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\ContactFormBundle\Entity\ContactFormTranslation" table="nowo_contact_form_translation" repository-class="Nowo\ContactFormBundle\Repository\ContactFormTranslationRepository">
        <unique-constraints>
            <unique-constraint name="uniq_contact_form_translation_locale" columns="form_id,locale"/>
        </unique-constraints>
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>
        <field name="locale" type="string" length="10"/>
        <field name="title" type="string" length="255"/>
        <field name="description" type="text" nullable="true"/>
        <field name="successMessage" column="success_message" type="text" nullable="true"/>
        <field name="consentLabel" column="consent_label" type="text" nullable="true"/>
        <field name="privacyPolicyText" column="privacy_policy_text" type="text" nullable="true"/>
        <many-to-one field="form" target-entity="Nowo\ContactFormBundle\Entity\ContactForm" inversed-by="translations">
            <join-column nullable="false" on-delete="CASCADE"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
